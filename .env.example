# Variables d'environnement TabNest — copie ce fichier en `.env.local`
# (`.env.local` n'est jamais commité).

# --- Application web (Vite) ---
# Projet Supabase → Project Settings → API
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIQUE

# --- Optionnel : paiement (Lemon Squeezy) ---
# Tant que ces liens sont absents, les offres payantes restent affichées « à venir ».
VITE_LS_CHECKOUT_PLUS=
VITE_LS_CHECKOUT_PRO=

# --- Optionnel : mesure d'audience (PostHog, seulement avec consentement) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Tests automatisés (scripts/check-*.mjs) ---
# Compte de démonstration utilisé par les tests Playwright.
# À créer et à renouveler régulièrement ; ne jamais réutiliser un vrai mot de passe.
TABNEST_DEMO_EMAIL=
TABNEST_DEMO_PASSWORD=

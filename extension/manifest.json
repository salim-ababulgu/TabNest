{
  "manifest_version": 3,
  "name": "TabNest Capture",
  "version": "0.6.1",
  "description": "Capture automatiquement les pages que vous visitez pour TabNest.",
  "permissions": [
    "tabs",
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://tabnest-alb.pages.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page-meta.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TabNest Capture",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "homepage_url": "https://tabnest-alb.pages.dev/extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_permissions": [
    "history",
    "bookmarks"
  ]
}

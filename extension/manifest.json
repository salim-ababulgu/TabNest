{
  "manifest_version": 3,
  "name": "TabNest Capture",
  "version": "0.1.0",
  "description": "Capture automatiquement les pages que vous visitez pour TabNest.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TabNest Capture",
    "default_popup": "popup.html"
  }
}
